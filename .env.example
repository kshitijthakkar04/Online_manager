# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Text model for review / writing / answering. Any current Gemini model code works.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# Server-only key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Access lock (strongly recommended once deployed) ---
# Leave APP_PASSWORD empty to disable the lock (local dev only).
APP_PASSWORD=
# Any long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=
